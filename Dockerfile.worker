FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN groupadd --system app && useradd --system --gid app --create-home app

COPY pyproject.toml README.md LICENSE ./
COPY app ./app
RUN python -m pip install --upgrade pip && python -m pip install .

USER app

# No EXPOSE and no port binding: the worker is an outbound-only queue consumer.
# It dials CloudPod and never accepts inbound connections.

# The main Dockerfile's health check probes the web API on :8765. This image runs no
# HTTP server, so reusing that check would mark a perfectly healthy worker unhealthy on
# every interval. Liveness is instead asserted from the worker's own drain loop: it
# writes a heartbeat file after each successful poll cycle, and the container is
# unhealthy if that file goes stale.
#
# The staleness window is deliberately generous relative to FCC_WORKER_POLL_SECONDS=3:
# a single slow ESPN fetch or a long analysis must not flap the container.
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD python -c "import os,sys,time; p='/tmp/leaguepilot-worker.heartbeat'; sys.exit(0 if os.path.exists(p) and (time.time()-os.path.getmtime(p)) < 180 else 1)"

CMD ["leaguepilot-ai", "worker"]
