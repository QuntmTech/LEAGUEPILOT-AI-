# Copy to .env only for manual setup. `./scripts/start-local.sh` creates secure values automatically.
FCC_ENVIRONMENT=development
FCC_HOST=127.0.0.1
FCC_PORT=8765
FCC_DATABASE_URL=sqlite:///./.data/fantasy-command-center.db
FCC_ADMIN_TOKEN=GENERATE_A_RANDOM_TOKEN_WITH_AT_LEAST_32_CHARACTERS
FCC_ENCRYPTION_KEY=GENERATE_WITH_PYTHON_M_APP_CLI_INIT
FCC_JOB_TOKEN=GENERATE_A_SEPARATE_RANDOM_TOKEN
FCC_DEFAULT_SEASON=2026
FCC_DEMO_MODE=false
FCC_AI_PROVIDER=rules
FCC_AI_MODEL=
FCC_AI_API_KEY=
FCC_AI_BASE_URL=
FCC_CORS_ORIGINS=
FCC_LOGIN_ATTEMPT_LIMIT=6
FCC_LOGIN_WINDOW_SECONDS=60

# CloudPod worker (required only for `leaguepilot-ai worker`)
FCC_CLOUDPOD_URL=https://leaguepilot-ai.cloudpod.pro
FCC_CLOUDPOD_WORKER_KEY=SET_FROM_A_PASSWORD_MANAGER_OR_SECRET_STORE
FCC_CLOUDPOD_WORKER_ID=leaguepilot-worker-1
FCC_WORKER_POLL_SECONDS=3
FCC_WORKER_REQUEST_TIMEOUT_SECONDS=30
