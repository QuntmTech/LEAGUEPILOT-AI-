{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  // worker/ and db/ target the Cloudflare Workers runtime and are typechecked by
  // tsconfig.worker.json, whose globals (Fetcher, D1Database) conflict with the DOM lib.
  "exclude": [
    "node_modules",
    "dist",
    // worker/ and db/ target the Cloudflare Workers runtime; they are typechecked by
    // tsconfig.worker.json, whose globals conflict with the DOM lib.
    "worker",
    "db",
    // Starter-template scaffolding. Nothing in the app imports it and no build input
    // references it, but examples/d1 imports ../../../../../db, which dragged
    // Worker-runtime code into this DOM-typed program.
    "examples"
  ]
}
